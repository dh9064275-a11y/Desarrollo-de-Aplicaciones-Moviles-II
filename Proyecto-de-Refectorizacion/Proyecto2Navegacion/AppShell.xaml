<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="Proyecto2Navegacion.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Proyecto2Navegacion.Views"
    Title="Proyecto 2 - Navegación">

    <!-- Pestañas principales -->
    <TabBar>

        <ShellContent
            Title="Inicio"
            ContentTemplate="{DataTemplate views:InicioPage}"
            Route="InicioPage" />

        <ShellContent
            Title="Perfil"
            ContentTemplate="{DataTemplate views:PerfilPage}"
            Route="PerfilPage" />

        <ShellContent
            Title="Ajustes"
            ContentTemplate="{DataTemplate views:AjustesPage}"
            Route="AjustesPage" />

    </TabBar>

</Shell>