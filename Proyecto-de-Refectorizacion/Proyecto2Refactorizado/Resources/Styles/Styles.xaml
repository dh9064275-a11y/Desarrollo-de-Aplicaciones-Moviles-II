<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Proyecto2Refactorizado.Resources.Styles.Styles">

    <!-- Estilo general para botones -->
    <Style TargetType="Button">

        <Setter Property="BackgroundColor"
                Value="{DynamicResource Primary}" />

        <Setter Property="TextColor"
                Value="White" />

        <Setter Property="FontSize"
                Value="15" />

        <Setter Property="FontAttributes"
                Value="Bold" />

        <Setter Property="CornerRadius"
                Value="10" />

        <Setter Property="Padding"
                Value="22,12" />

    </Style>

    <!-- Estilo general para títulos -->
    <Style x:Key="PageTitleStyle"
           TargetType="Label">

        <Setter Property="TextColor"
                Value="{DynamicResource TextPrimary}" />

        <Setter Property="FontSize"
                Value="34" />

        <Setter Property="FontAttributes"
                Value="Bold" />

    </Style>

    <!-- Texto secundario -->
    <Style x:Key="SecondaryTextStyle"
           TargetType="Label">

        <Setter Property="TextColor"
                Value="{DynamicResource TextSecondary}" />

        <Setter Property="FontSize"
                Value="16" />

    </Style>

</ResourceDictionary>