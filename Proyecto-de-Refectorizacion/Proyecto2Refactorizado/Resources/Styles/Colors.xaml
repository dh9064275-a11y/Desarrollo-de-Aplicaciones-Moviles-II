<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Proyecto2Refactorizado.Resources.Styles.Colors">

    <!--
        PALETA VISUAL DEL PROYECTO

        Negro: estructura y navegación.
        Rojo: color de acento y acciones.
        Blanco roto: fondo principal.
        Gris: información secundaria.
    -->

    <Color x:Key="Primary">#D72638</Color>
    <Color x:Key="PrimaryDark">#A71928</Color>

    <Color x:Key="BackgroundColor">#F5F3EE</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>

    <Color x:Key="DarkColor">#111111</Color>
    <Color x:Key="DarkSurfaceColor">#1C1C1C</Color>

    <Color x:Key="TextPrimary">#111111</Color>
    <Color x:Key="TextSecondary">#777777</Color>

    <Color x:Key="BorderColor">#E0DDD6</Color>

</ResourceDictionary>